# Copiar para agente-sgp-php/.env e preencher (ou usar secrets.php).
# NUNCA commitar o .env real.

# Banco MySQL da PM — os MESMOS valores do backend web.
MYSQL_HOST=mysql-svc.database.svc.cluster.local
MYSQL_PORT=3306
MYSQL_USER=dashboard_40bpmi
MYSQL_PASSWORD=
MYSQL_DATABASE=dashboard_40bpmi

# Intervalo entre verificações de pedidos pendentes (ms).
POLL_INTERVAL_MS=60000

# Intervalo entre chamadas ao WSSCPM/SGP-DP durante um lote (ms).
CALL_DELAY_MS=1500

# Caminho do certificado da CA interna do SGP-DP (só p/ IAS/cursos/láureas).
# Padrão: ./certs/sgp-dp-ca.pem
# SGPDP_CA_CERT_PATH=
