# =============================================================
# Copie este arquivo para .env e preencha com os valores reais
# O arquivo .env NUNCA deve ser commitado no git
# =============================================================

# Supabase — use a SERVICE_ROLE key (não a anon/publishable)
# Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT — gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cole_aqui_uma_string_aleatoria_de_64_chars_minimo

# Ambiente (production em produção)
NODE_ENV=production

# Cookie de sessão com flag Secure — só funciona se o site for servido via HTTPS.
# Servidor local em HTTP puro (LAN sem certificado): deixe false (ou omita).
# Atrás de HTTPS real (domínio com certificado): true.
COOKIE_SECURE=false

# Confiar no header X-Forwarded-For de um proxy na frente (Vercel/nginx/IIS).
# Servidor local rodando direto (sem proxy): deixe false (ou omita) — senão qualquer
# cliente da rede pode forjar o header e burlar o rate limiter de login.
TRUST_PROXY=false

# Porta do servidor (padrão 3001 se omitido)
PORT=3001

# CORS — origem permitida (ex: https://seu-dominio.vercel.app). Deixe vazio para liberar todas (dev/LAN).
ALLOWED_ORIGIN=
