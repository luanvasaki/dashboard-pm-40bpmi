# =============================================================
# Copie este arquivo para backend/.env e preencha com os valores reais
# O arquivo .env NUNCA deve ser commitado no git
# =============================================================

# ── Banco de dados MySQL (servidor da PM) ────────────────────
# Dados fornecidos pela TI da PM. O host precisa ser alcançável a partir
# de onde o Node roda (se for cluster k8s, o Node roda dentro do cluster e
# o host é o service interno; se for uma VM, use o host/porta externos).
MYSQL_HOST=mysql-svc.database.svc.cluster.local
MYSQL_PORT=3306
MYSQL_USER=dashboard_40bpmi
MYSQL_PASSWORD=
MYSQL_DATABASE=dashboard_40bpmi
# Tamanho do pool de conexões (opcional, padrão 10)
MYSQL_POOL_SIZE=10

# ── Autenticação ────────────────────────────────────────────
# JWT — gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cole_aqui_uma_string_aleatoria_de_64_chars_minimo

# ── Ambiente ────────────────────────────────────────────────
NODE_ENV=production

# Cookie de sessão com flag Secure — só funciona se o site for servido via HTTPS.
# HTTP puro (sem certificado): deixe false. Atrás de HTTPS real: true.
COOKIE_SECURE=false

# Confiar no header X-Forwarded-For de um proxy na frente (nginx/ingress/IIS).
# Sem proxy: deixe false — senão dá pra forjar o header e burlar o rate limiter de login.
TRUST_PROXY=false

# Porta do servidor (padrão 3001 se omitido)
PORT=3001

# CORS — origem permitida (ex: https://intranet.policiamilitar.sp.gov.br).
# Vazio = libera todas (ok em rede interna fechada).
ALLOWED_ORIGIN=
