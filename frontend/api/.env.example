# =============================================================
# Copie este arquivo para frontend/api/.env e preencha.
# O .env NUNCA deve ser commitado (já está no .gitignore).
# =============================================================

# ── Banco de dados MySQL (servidor da PM) ────────────────────
# Dados fornecidos pela TI. Como o PHP roda no mesmo ambiente do phpMyAdmin
# (cluster), o host é o service interno do MySQL.
MYSQL_HOST=mysql-svc.database.svc.cluster.local
MYSQL_PORT=3306
MYSQL_USER=dashboard_40bpmi
MYSQL_PASSWORD=
MYSQL_DATABASE=dashboard_40bpmi

# ── Autenticação ────────────────────────────────────────────
# JWT — gere com:  php -r "echo bin2hex(random_bytes(64));"
JWT_SECRET=cole_aqui_uma_string_aleatoria_de_64_chars_minimo

# ── Ambiente ────────────────────────────────────────────────
# Cookie de sessão com flag Secure — só marque true se o site for HTTPS real.
COOKIE_SECURE=false

# Confiar no header X-Forwarded-For (proxy/ingress na frente). Sem proxy: false
# (senão dá pra forjar o header e burlar o rate limiter de login).
TRUST_PROXY=false

# CORS — origem permitida (vazio = mesma origem; ok em rede interna fechada).
ALLOWED_ORIGIN=

# Diretório de cache/estado (RAC PM + rate limiting). Opcional — por padrão usa
# o temp do sistema ou frontend/api/.cache. Precisa ser gravável pelo PHP.
# APP_CACHE_DIR=/var/www/dashboard-cache
