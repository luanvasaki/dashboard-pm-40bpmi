<?php
/**
 * secrets.php.example — copie para  frontend/api/secrets.php  e preencha.
 * O secrets.php real NUNCA vai pro git (.gitignore cobre *secrets.php).
 *
 * Vantagem sobre o .env: um arquivo .php pedido direto pelo navegador só
 * executa (não imprime nada), então as credenciais não vazam mesmo que o
 * host esteja sem .htaccess / com AllowOverride desligado.
 *
 * As variáveis reais do ambiente (getenv) têm prioridade sobre este arquivo.
 */

return [
    // ── MySQL da PM (mesmo ambiente do phpMyAdmin — host interno do cluster) ──
    'MYSQL_HOST'     => 'mysql-svc.database.svc.cluster.local',
    'MYSQL_PORT'     => '3306',
    'MYSQL_USER'     => 'dashboard_40bpmi',
    'MYSQL_PASSWORD' => '',
    'MYSQL_DATABASE' => 'dashboard_40bpmi',

    // ── Autenticação ──
    // Gere com:  php -r "echo bin2hex(random_bytes(64));"
    'JWT_SECRET' => 'cole_aqui_uma_string_aleatoria_de_64_chars_minimo',

    // ── Ambiente ──
    'COOKIE_SECURE'  => 'false',  // 'true' só com HTTPS real
    'TRUST_PROXY'    => 'false',  // 'true' só se houver proxy/ingress na frente
    'ALLOWED_ORIGIN' => '',       // vazio = mesma origem

    // Opcional: diretório gravável para o cache do RAC PM e o rate limiter.
    // 'APP_CACHE_DIR' => '/var/www/dashboard-cache',
];
