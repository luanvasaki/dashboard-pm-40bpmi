# Copiar para .env e preencher. NUNCA commitar o .env real.

SUPABASE_URL=
SUPABASE_KEY=

# Intervalo entre verificações de pedidos pendentes (ms). Sem pressa — não é busca em tempo real.
POLL_INTERVAL_MS=60000

# Intervalo entre chamadas ao WSSCPM durante uma atualização em lote (ms). Evita sobrecarregar o serviço deles.
CALL_DELAY_MS=1500

# Caminho do certificado da CA interna do SGP-DP (só necessário pra sincronizar
# IAS/cursos, não afeta o WSSCPM). Opcional — por padrão o agente já procura em
# ./certs/sgp-dp-ca.pem. Só preencher aqui se quiser guardar o certificado em
# outro lugar. Ver instruções em README.md.
# SGPDP_CA_CERT_PATH=
